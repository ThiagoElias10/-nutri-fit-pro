# Porta do servidor HTTP
PORT=3002

# Host onde o servidor escuta (use 0.0.0.0 para aceitar conexões de fora, ex: deploy)
HOST=0.0.0.0

# Segredo usado para assinar os tokens JWT.
# Se não definido, um segredo aleatório é gerado e persistido ao lado do banco de dados.
# Em produção (Render), defina um valor fixo via variável de ambiente.
JWT_SECRET=

# Diretório alternativo do arquivo de banco (padrão: pasta do projeto, ou userData no Electron)
# DB_PATH=C:\dados\nutrifit.db

# Origens permitidas no CORS (separadas por vírgula). Se vazio, apenas localhost.
CORS_ORIGINS=http://localhost:5173

# Cookies https com Secure (deixe 'true' apenas atrás de HTTPS)
COOKIE_SECURE=false

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
